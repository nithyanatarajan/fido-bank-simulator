{
  "name": "fido-bank-simulator-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run --coverage",
    "lint:check": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx}'",
    "format:fix": "prettier --write 'src/**/*.{js,jsx,ts,tsx}'",
    "check": "pnpm run lint:check && pnpm run format:check",
    "fix": "pnpm run lint:fix && pnpm run format:fix"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.17",
    "eslint-config-prettier": "^10.1.8"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  }
}
